generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  INTERESTED
  NOT_INTERESTED
  CONVERTED
  BOUNCED
  UNSUBSCRIBED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DELIVERED
  READ
  REPLIED
  UNSUBSCRIBED
  CONVERTED
  BOUNCED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum EventType {
  CAMPAIGN_CREATED
  CAMPAIGN_STARTED
  CAMPAIGN_PAUSED
  CAMPAIGN_COMPLETED
  LEAD_IMPORTED
  LEAD_UPDATED
  LEAD_UNSUBSCRIBED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  MESSAGE_QUEUED
  MESSAGE_SENT
  MESSAGE_FAILED
  MESSAGE_DELIVERED
  MESSAGE_READ
  REPLY_RECEIVED
  CONVERSION_RECORDED
}

enum ConversationSource {
  CAMPAIGN
  MANUAL
  WEBHOOK
}

model User {
  id            String   @id @default(uuid())
  company_name  String
  email         String   @unique
  password_hash String
  role          UserRole @default(OWNER)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  sessions            Session[]
  whatsapp_accounts   WhatsappAccount[]
  leads               Lead[]
  lead_tags           LeadTag[]
  templates           Template[]
  campaigns           Campaign[]
  messages            Message[]
  conversations       Conversation[]
  activity_logs       ActivityLog[]
  analytics_snapshots AnalyticsSnapshot[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model WhatsappAccount {
  id                             String   @id @default(uuid())
  user_id                        String
  account_name                   String
  phone_number_id                String   @unique
  business_account_id            String
  access_token_encrypted         String
  webhook_verify_token_encrypted String
  display_phone_number           String
  is_active                      Boolean  @default(true)
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  leads         Lead[]
  campaigns     Campaign[]
  messages      Message[]
  conversations Conversation[]

  @@index([business_account_id])
  @@map("whatsapp_accounts")
}

model Lead {
  id                  String     @id @default(uuid())
  user_id             String
  whatsapp_account_id String?
  phone_number        String
  first_name          String?
  last_name           String?
  email               String?
  source              String?
  custom_fields_json  Json?
  opt_in              Boolean    @default(false)
  unsubscribed        Boolean    @default(false)
  unsubscribed_at     DateTime?
  status              LeadStatus @default(NEW)
  notes               String?
  deleted_at          DateTime?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  whatsapp_account      WhatsappAccount?      @relation(fields: [whatsapp_account_id], references: [id], onDelete: SetNull)
  campaign_leads        CampaignLead[]
  messages              Message[]
  activity_logs         ActivityLog[]
  conversation_messages ConversationMessage[]
  lead_tag_assignments  LeadTagAssignment[]
  conversations         Conversation[]

  @@unique([user_id, phone_number])
  @@index([user_id])
  @@index([phone_number])
  @@index([status])
  @@index([unsubscribed])
  @@index([opt_in])
  @@map("leads")
}

model LeadTag {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  color      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user                 User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lead_tag_assignments LeadTagAssignment[]

  @@unique([user_id, name])
  @@map("lead_tags")
}

model LeadTagAssignment {
  id         String   @id @default(uuid())
  lead_id    String
  tag_id     String
  created_at DateTime @default(now())

  lead Lead    @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  tag  LeadTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([lead_id, tag_id])
  @@map("lead_tag_assignments")
}

model Template {
  id                      String    @id @default(uuid())
  user_id                 String
  name                    String
  body                    String
  placeholder_schema_json Json?
  preview_example_json    Json?
  is_archived             Boolean   @default(false)
  version                 Int       @default(1)
  deleted_at              DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([user_id, name, version])
  @@map("templates")
}

model Campaign {
  id                  String         @id @default(uuid())
  user_id             String
  whatsapp_account_id String
  template_id         String
  name                String
  description         String?
  status              CampaignStatus @default(DRAFT)
  scheduled_at        DateTime?
  started_at          DateTime?
  completed_at        DateTime?
  batch_size          Int?
  delay_in_seconds    Int?
  total_recipients    Int            @default(0)
  total_queued        Int            @default(0)
  total_sent          Int            @default(0)
  total_delivered     Int            @default(0)
  total_read          Int            @default(0)
  total_replied       Int            @default(0)
  total_converted     Int            @default(0)
  total_failed        Int            @default(0)
  total_unsubscribed  Int            @default(0)
  deleted_at          DateTime?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  whatsapp_account      WhatsappAccount       @relation(fields: [whatsapp_account_id], references: [id])
  template              Template              @relation(fields: [template_id], references: [id])
  campaign_leads        CampaignLead[]
  messages              Message[]
  analytics_snapshots   AnalyticsSnapshot[]
  activity_logs         ActivityLog[]
  conversation_messages ConversationMessage[]

  @@index([user_id])
  @@index([status])
  @@index([scheduled_at])
  @@map("campaigns")
}

model CampaignLead {
  id              String    @id @default(uuid())
  campaign_id     String
  lead_id         String
  status          String    @default("QUEUED")
  excluded_reason String?
  scheduled_for   DateTime?
  processed_at    DateTime?
  attempt_count   Int       @default(0)
  last_attempt_at DateTime?
  next_attempt_at DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  campaign Campaign  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  lead     Lead      @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([campaign_id, lead_id])
  @@index([campaign_id])
  @@index([lead_id])
  @@map("campaign_leads")
}

model Message {
  id                  String           @id @default(uuid())
  user_id             String
  whatsapp_account_id String
  campaign_id         String?
  lead_id             String
  campaign_lead_id    String?
  direction           MessageDirection
  status              MessageStatus
  whatsapp_message_id String?          @unique
  template_snapshot   Json?
  rendered_body       String?
  failure_reason      String?
  queued_at           DateTime?
  sending_at          DateTime?
  sent_at             DateTime?
  delivered_at        DateTime?
  read_at             DateTime?
  replied_at          DateTime?
  bounced_at          DateTime?
  retry_count         Int              @default(0)
  last_retry_at       DateTime?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  whatsapp_account      WhatsappAccount       @relation(fields: [whatsapp_account_id], references: [id])
  campaign              Campaign?             @relation(fields: [campaign_id], references: [id])
  lead                  Lead                  @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  campaign_lead         CampaignLead?         @relation(fields: [campaign_lead_id], references: [id])
  message_events        MessageEvent[]
  conversation_messages ConversationMessage[]
  activity_logs         ActivityLog[]

  @@unique([campaign_id, lead_id, direction])
  @@index([campaign_id])
  @@index([lead_id])
  @@index([status])
  @@index([direction])
  @@index([sent_at])
  @@map("messages")
}

model MessageEvent {
  id                 String    @id @default(uuid())
  message_id         String
  event_type         EventType
  event_payload_json Json?
  occurred_at        DateTime  @default(now())
  created_at         DateTime  @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@index([occurred_at])
  @@map("message_events")
}

model Conversation {
  id                  String             @id @default(uuid())
  user_id             String
  lead_id             String
  whatsapp_account_id String
  source              ConversationSource
  last_message_at     DateTime?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lead                  Lead                  @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  whatsapp_account      WhatsappAccount       @relation(fields: [whatsapp_account_id], references: [id])
  conversation_messages ConversationMessage[]

  @@unique([user_id, lead_id, whatsapp_account_id])
  @@index([lead_id])
  @@index([last_message_at])
  @@map("conversations")
}

model ConversationMessage {
  id                  String           @id @default(uuid())
  conversation_id     String
  lead_id             String
  campaign_id         String?
  direction           MessageDirection
  body                String
  whatsapp_message_id String?
  message_id          String?
  sent_at             DateTime?
  received_at         DateTime?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  message      Message?     @relation(fields: [message_id], references: [id], onDelete: SetNull)

  @@map("conversation_messages")
}

model ActivityLog {
  id            String    @id @default(uuid())
  user_id       String
  lead_id       String?
  campaign_id   String?
  message_id    String?
  event_type    EventType
  description   String?
  metadata_json Json?
  created_at    DateTime  @default(now())

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  message  Message?  @relation(fields: [message_id], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model AnalyticsSnapshot {
  id                 String   @id @default(uuid())
  user_id            String
  campaign_id        String
  snapshot_date      DateTime
  total_recipients   Int      @default(0)
  total_sent         Int      @default(0)
  total_delivered    Int      @default(0)
  total_read         Int      @default(0)
  total_replied      Int      @default(0)
  total_converted    Int      @default(0)
  total_failed       Int      @default(0)
  total_unsubscribed Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, snapshot_date])
  @@index([snapshot_date])
  @@map("analytics_snapshots")
}
